# Copy to .env (never commit .env)

BREATHE_API_KEY=
BREATHE_API_BASE=https://api.breathelondon-communities.org/api

year_of_report=2025

BL_SITE_CODE=CLDP0299
BL_SPECIES_NO2=INO2
BL_SPECIES_PM25=IPM25
BL_DATA_SOURCE=api
BL_NO2_CSV=data/processed/no2.csv
BL_PM25_CSV=data/processed/pm25.csv
BL_BREATHE_EXPORT=0

# Report: all data = site StartDate→EndDate from listSensors.json (run fetch_sensors.R first).
# Quarter overlay = last completed calendar quarter (automatic).

# --- PM2.5 multi-site plots (scripts/generate_plots.R) ---
# Dates below are for multi-site plots only (not the quarterly PDF report).
# Leave both empty = per-site StartDate to formal EndDate (official decommission).
# Do not use HourlyBulletinEnd — bulletin can extend past decommission during takedown.
BL_PLOT_START_DATE=
BL_PLOT_END_DATE=
# Or set a shared window, e.g. 01 Jan 2024 00:00:00 GMT / 31 Dec 2024 23:00:00 GMT
# single = BL_SITE_CODE only | selected = BL_PLOT_SITE_CODES | all = listSensors.json
BL_PLOT_MODE=all
# Comma-separated codes — only when BL_PLOT_MODE=selected (not used for all)
# BL_PLOT_SITE_CODES=CLDP0299,CLDP0608
BL_PLOT_SPECIES=IPM25
# 0 = fetch from API (resumes cache, skips sites already downloaded)
# 1 = load cache only, no API
BL_PLOT_USE_CACHE=0
BL_PLOT_CACHE_CSV=data/processed/pm25_all_sites.csv
BL_PLOT_OUTPUT=output/pm25_all_sites.png
# hourly | daily (daily uses openair::timeAverage per site)
BL_PLOT_AGG=daily

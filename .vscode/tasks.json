{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Breathe: Fetch sensor list",
      "type": "shell",
      "command": "Rscript scripts/fetch_sensors.R",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Breathe: Fetch readings (uses .env)",
      "type": "shell",
      "command": "Rscript scripts/fetch_readings.R",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Breathe: Generate PM2.5 all-sites plot",
      "type": "shell",
      "command": "Rscript scripts/generate_plots.R",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build"
    },
    {
      "label": "Breathe: Knit quarterly report (PDF)",
      "type": "shell",
      "command": "Rscript scripts/render_quarterly_report.R",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
